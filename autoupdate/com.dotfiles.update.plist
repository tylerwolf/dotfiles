<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dotfiles.update</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>D="$HOME/.dotfiles"; git -C "$D" remote get-url updates >/dev/null 2>&amp;1 || git -C "$D" remote add updates https://github.com/tylerwolf/dotfiles.git; git -C "$D" fetch -q updates &amp;&amp; git -C "$D" merge -q --ff-only updates/main; exec "$D/bin/dotfiles" update</string>
	</array>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StartInterval</key>
	<integer>7200</integer>
	<key>StandardOutPath</key>
	<string>$HOME/Library/Logs/dotfiles-update.log</string>
	<key>StandardErrorPath</key>
	<string>$HOME/Library/Logs/dotfiles-update.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>$HOME</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>DOTFILES_LAUNCHD</key>
		<string>1</string>
	</dict>
</dict>
</plist>
