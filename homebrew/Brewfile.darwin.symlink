# macOS packages (Homebrew). Keep in sync with pacman/packages.txt (Arch) and
# apt/packages.txt + mise/cli-tools.debian.toml (Ubuntu).

# Replace outdated system libraries
brew 'git'
brew 'openssl'
brew 'zsh'

# Core CLI tools
brew 'coreutils'
brew 'findutils'
brew 'shellcheck'

# Modern replacements
brew 'ripgrep'      # fast code search (replaces ack)
brew 'fd'           # fast find replacement
brew 'bat'          # cat with syntax highlighting
brew 'eza'          # modern ls with git awareness (eza --tree replaces tree)
brew 'git-delta'    # better git diffs (replaces diff-so-fancy)
brew 'zoxide'       # smarter cd (replaces z)
brew 'fzf'          # fuzzy finder for everything
brew 'atuin'        # better shell history (replaces zsh history)

# Development tools
brew 'mise'         # runtime versions (replaces asdf) + per-directory env (replaces direnv)
brew 'gh'           # GitHub CLI
brew 'jq'           # JSON processor

# Utilities
brew 'btop'         # system monitor
brew 'tealdeer'     # tldr client (the `tldr` formula was disabled upstream)
brew 'cowsay'

# Apps
cask 'ghostty'      # terminal (same config on macOS and Linux, see ghostty/)
