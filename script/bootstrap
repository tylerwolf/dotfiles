#!/bin/sh
#
# bootstrap — set up a new machine from nothing.
#
#   sh -c "$(curl -fsSL https://raw.githubusercontent.com/tylerwolf/dotfiles/main/script/bootstrap)"
#
# Installs the bare prerequisites (git; Command Line Tools on macOS), clones the
# repo to ~/.dotfiles over https, runs `dotfiles install`, then offers to create
# and register an SSH key for this machine. Safe to re-run: an existing clone is
# reused. Everything after the clone lives in bin/dotfiles.
#
# Environment:
#   DOTFILES_DIR     where to clone (default ~/.dotfiles)
#   DOTFILES_REPO    git URL or local path to clone from (default the GitHub repo)
#   DOTFILES_BRANCH  branch to check out (default: the repo's default branch)

set -e

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/tylerwolf/dotfiles.git}"
DOTFILES_BRANCH="${DOTFILES_BRANCH:-}"

info() { printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1" >&2; }
success() { printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1" >&2; }
fail() {
	printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1" >&2
	exit 1
}

detect_os() {
	case "$(uname -s)" in
	Darwin) OS=darwin ;;
	Linux) OS=linux ;;
	*) fail "unsupported OS: $(uname -s)" ;;
	esac
	DISTRO=""
	if [ "$OS" = linux ]; then
		if [ -f /etc/arch-release ]; then
			DISTRO=arch
		elif [ -f /etc/debian_version ]; then
			DISTRO=debian
		fi
	fi
}

# The bare minimum needed to clone the repo; `dotfiles install` does the rest.
install_prerequisites() {
	case "$OS" in
	darwin)
		if ! xcode-select -p >/dev/null 2>&1; then
			info "installing Xcode Command Line Tools (follow the dialog)"
			xcode-select --install 2>/dev/null || true
			until xcode-select -p >/dev/null 2>&1; do sleep 10; done
			success "Command Line Tools installed"
		fi
		;;
	linux)
		command -v sudo >/dev/null 2>&1 || fail "sudo is required"
		if ! command -v git >/dev/null 2>&1; then
			info "installing git"
			case "$DISTRO" in
			arch) sudo pacman -Syu --needed --noconfirm git ;;
			debian) sudo apt-get update -q && sudo apt-get install -y -q git ;;
			*) fail "unknown Linux distro; install git and re-run" ;;
			esac
		fi
		;;
	esac
	command -v git >/dev/null 2>&1 || fail "git is still missing"
	success "prerequisites present"
}

clone_repo() {
	if [ -x "$DOTFILES_DIR/bin/dotfiles" ]; then
		success "using existing clone at $DOTFILES_DIR"
		return 0
	fi
	[ -e "$DOTFILES_DIR" ] && fail "$DOTFILES_DIR exists but is not a dotfiles clone"
	info "cloning $DOTFILES_REPO to $DOTFILES_DIR"
	if [ -n "$DOTFILES_BRANCH" ]; then
		git clone --branch "$DOTFILES_BRANCH" "$DOTFILES_REPO" "$DOTFILES_DIR"
	else
		git clone "$DOTFILES_REPO" "$DOTFILES_DIR"
	fi
	success "cloned"
}

main() {
	echo ""
	detect_os
	info "platform: $OS${DISTRO:+ $DISTRO}"
	install_prerequisites
	clone_repo

	"$DOTFILES_DIR/bin/dotfiles" install || fail "dotfiles install failed"

	if [ -t 0 ]; then
		"$DOTFILES_DIR/bin/dotfiles" ssh-key || true
	else
		info "no terminal; run 'dotfiles ssh-key' later to register an SSH key with GitHub"
	fi

	echo ""
	echo "  All set. Next:"
	echo "    - open a new terminal (log out and back in if your login shell changed)"
	if [ "$OS" = darwin ]; then
		echo "    - optionally apply macOS preferences: dotfiles defaults"
	fi
	echo "    - check everything: dotfiles verify"
	echo ""
}

main "$@"
