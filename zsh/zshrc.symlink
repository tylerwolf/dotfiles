#!/bin/zsh
# shortcut to this dotfiles path is $DOTFILES
export DOTFILES="$HOME/.dotfiles"

# your project folder that we can `c [tab]` to
export PROJECTS="$HOME/Code"

# your default editor
export EDITOR='vim'

# keep PATH free of duplicates (reload! re-sources every path file)
typeset -U path PATH

# platform tags: "darwin", "linux arch" or "linux debian".
# Mirrors script/os.sh without forking a process.
case "$OSTYPE" in
  darwin*) DOTFILES_OS=darwin ;;
  linux*)  DOTFILES_OS=linux ;;
  *)       DOTFILES_OS=unknown ;;
esac
DOTFILES_DISTRO=
if [[ $DOTFILES_OS == linux ]]; then
  if [[ -r /etc/os-release ]]; then
    () {
      local line ids=" "
      for line in "${(f)$(</etc/os-release)}"; do
        case $line in
          (ID=*|ID_LIKE=*) ids+="${${line#*=}//\"/} " ;;
        esac
      done
      case $ids in
        (*" arch "*|*" cachyos "*|*" endeavouros "*|*" manjaro "*) DOTFILES_DISTRO=arch ;;
        (*" debian "*|*" ubuntu "*) DOTFILES_DISTRO=debian ;;
      esac
    }
  fi
  if [[ -z $DOTFILES_DISTRO ]]; then
    if [[ -f /etc/arch-release ]]; then DOTFILES_DISTRO=arch
    elif [[ -f /etc/debian_version ]]; then DOTFILES_DISTRO=debian
    fi
  fi
fi
export DOTFILES_OS DOTFILES_DISTRO
export DOTFILES_TAGS="$DOTFILES_OS${DOTFILES_DISTRO:+ $DOTFILES_DISTRO}"

# all of our zsh files, minus those tagged for another platform
# (foo.darwin.zsh loads only on macOS; foo.linux.zsh, foo.arch.zsh, foo.debian.zsh likewise)
typeset -U config_files
config_files=($DOTFILES/*/*.zsh)
for tag in darwin linux arch debian; do
  [[ " $DOTFILES_TAGS " == *" $tag "* ]] && continue
  config_files=(${config_files:#*.$tag.zsh})
done

# load the path files
for file in ${(M)config_files:#*/path(|.*).zsh}; do
  source "$file"
done

# load antidote plugins (generated by antidote/install.sh)
[ -f ~/.zsh_plugins.zsh ] && source ~/.zsh_plugins.zsh

# load everything but the path and completion files
for file in ${${config_files:#*/path(|.*).zsh}:#*/completion(|.*).zsh}; do
  source "$file"
done

autoload -Uz compinit
typeset -i updated_at=$(date +'%j' -r ~/.zcompdump 2>/dev/null || stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)
if [ $(date +'%j') != $updated_at ]; then
  compinit -i
else
  compinit -C -i
fi

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion(|.*).zsh}; do
  source "$file"
done

unset config_files updated_at tag file

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
# shellcheck disable=SC1090
[ -f ~/.localrc ] && . ~/.localrc
